<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.application.dogpackage.controller.PrincipalController"
            prefWidth="900" prefHeight="600">
   <left>
      <VBox spacing="10" prefWidth="180">
         <Label text="Dog-Package"/>
         <Button fx:id="btnInicio" text="Início" maxWidth="Infinity" onAction="#inicio" />
         <Button fx:id="btnCadastro" text="Encomendas" maxWidth="Infinity" onAction="#cadastro"/>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="areaConteudo"/>
   </center>
</BorderPane>