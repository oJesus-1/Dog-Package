<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.application.dogpackage.controller.InicialController"
      spacing="20">
   <Label text="Resumo das encomendas"/>
   <HBox spacing="20">
      <VBox  prefWidth="150" prefHeight="150" minWidth="150" minHeight="150">
         <Label fx:id="lblEntregues" text="0"/>
         <Label text="Entregues"/>
      </VBox>
      <VBox prefWidth="150" prefHeight="150" minWidth="150" minHeight="150">
         <Label fx:id="lblPendentes" text="0"/>
         <Label text="Pendentes"/>
      </VBox>
      <VBox prefWidth="150" prefHeight="150" minWidth="150" minHeight="150">
         <Label fx:id="lblTotal" text="0"/>
         <Label text="Total"/>
      </VBox>
   </HBox>
</VBox>