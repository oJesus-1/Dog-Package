<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="649.0" prefWidth="961.0" spacing="18" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.application.dogpackage.controller.CadastroController">
   <Label text="Encomendas" />

   <HBox prefHeight="177.0" prefWidth="961.0" spacing="30">
      <GridPane hgap="12" vgap="12">
         <Label text="Nome Produto" GridPane.columnIndex="0" GridPane.rowIndex="0" />
         <TextField fx:id="txtNomeProduto" promptText="ex: José" GridPane.columnIndex="1" />

         <Label text="Descrição" GridPane.rowIndex="1" />
         <TextField fx:id="txtDescricao" promptText="ex: 20cm, rosa e branco" GridPane.columnIndex="1" GridPane.rowIndex="1" />

         <Label text="Preço" GridPane.rowIndex="2" />
         <TextField fx:id="txtPreco" promptText="0,00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

         <Label text="Data do pedido" GridPane.columnIndex="2" GridPane.rowIndex="0" />
         <DatePicker fx:id="dpPedido" GridPane.columnIndex="3" GridPane.rowIndex="0" />

         <Label text="Data de entrega" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <DatePicker fx:id="dpEntrega" GridPane.columnIndex="3" GridPane.rowIndex="1" />

         <Label text="Status" GridPane.columnIndex="2" GridPane.rowIndex="2" />
         <ComboBox fx:id="cbStatus" GridPane.columnIndex="3" GridPane.rowIndex="2" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
      </GridPane>

      <VBox alignment="CENTER" spacing="8">
         <StackPane>
            <ImageView fx:id="imgPreview" fitHeight="148.0" fitWidth="264.0" pickOnBounds="true" />
         </StackPane>
         <HBox alignment="CENTER" spacing="8">
            <Button onAction="#escolherImagem" text="Escolher imagem" />
            <Button onAction="#ampliarImagem" text="Ampliar" />
         </HBox>
      </VBox>
   </HBox>

   <HBox prefHeight="25.0" prefWidth="400.0" spacing="10">
      <Button fx:id="btnSalvar" onAction="#salvar" text="Cadastrar" />
      <Button onAction="#limpar" text="Limpar / Nova" />
   </HBox>

   <Label text="Encomendas cadastradas (clique numa linha para editar)" />
   <TableView fx:id="tabela" editable="true" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colConcluida" prefWidth="85" text="Concluída" />
         <TableColumn fx:id="colId" prefWidth="45" text="ID" />
         <TableColumn fx:id="colNomeProduto" prefWidth="140" text="Nome" />
         <TableColumn fx:id="colDescricao" prefWidth="200" text="Descrição" />
         <TableColumn fx:id="colPreco" prefWidth="90" text="Preço" />
         <TableColumn fx:id="colPedido" prefWidth="95" text="Pedido" />
         <TableColumn fx:id="colEntrega" prefWidth="95" text="Entrega" />
         <TableColumn fx:id="colStatus" prefWidth="95" text="Status" />
      </columns>
   </TableView>
</VBox>
